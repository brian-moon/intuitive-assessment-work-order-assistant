# Copy to .env (never commit .env). Full templates: deploy/assessment.env.example, deploy/homelab.env.example.
# Model ladder (APP_LLM=auto, the default): LOCAL_LLM_BASE_URL set -> local model first; ANTHROPIC_API_KEY set ->
# Claude Haiku 5.5 (first tier when no local model); neither -> the labelled demo model. APP_LLM=scripted forces the demo.
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_TOKEN=
APP_MODEL=claude-haiku-5-5
