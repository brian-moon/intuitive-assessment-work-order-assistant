# Copy to .env next to docker-compose.yml:   cp .env.example .env
# docker compose reads it automatically; restart after a change:   docker compose up -d
# Never commit .env (it is in .gitignore).

# --- Where the app listens on this machine -------------------------------------------------------------------------
APP_PORT=8790                      # open http://localhost:8790
# APP_PUBLIC_URL=http://localhost:8790   # the link inside alert e-mails (defaults to localhost:APP_PORT)

# --- Models (the ladder: local -> Claude -> planner) ---------------------------------------------------------------
ANTHROPIC_API_KEY=                 # your own key; empty = the labelled demo model drafts instead
# APP_MODEL=claude-haiku-5-5
# LOCAL_LLM_BASE_URL=              # an Anthropic-compatible server for a local model (e.g. a gateway in front of Ollama)
# LOCAL_LLM_MODEL=qwen3.5:9b
# LOCAL_LLM_TOKEN=

# --- Users ---------------------------------------------------------------------------------------------------------
APP_DEMO_USERS=1                   # admin/admin-demo, planner/planner-demo, viewer/viewer-demo
# APP_USERS=admin:<password>:admin,planner:<password>:planner     # instead of the demo users (set APP_DEMO_USERS=0)
# APP_JWT_SECRET=<64 hex characters>                             # keeps sessions valid across restarts

# --- Critical-alert e-mail -----------------------------------------------------------------------------------------
ALERT_EMAILS=                      # registered at start-up, e.g. "Plant Admin <admin@example.com>, night@example.com"
                                   # (more on the Admin screen)
SMTP_HOST=                         # Gmail: smtp.gmail.com with an app password; empty = e-mail recorded as disabled
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=                       # defaults to SMTP_USER
# ALERT_EMAIL_COOLDOWN_MIN=15      # one e-mail per asset, metric and severity per recipient in this window

# --- Live telemetry simulator --------------------------------------------------------------------------------------
SIM_AUTOSTART=1                    # on from start-up (always-on); 0 = off until switched on; the dashboard switch works either way
SIM_RATE=6                         # events per SIM_UNIT (adjustable on the dashboard)
SIM_UNIT=minute                    # minute | hour

# --- Branding (optional) -------------------------------------------------------------------------------------------
# APP_BRAND_NAME=Work-order assistant
# APP_BRAND_SUBTITLE=Maintenance operations
# APP_BRAND_LOGO=logo.svg          # a file you put in ./branding (not committed)
